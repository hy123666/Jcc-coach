          "jcc:s17:index:entity_parse_quality",
          "jcc:s17:index:strategy_weight_calibration",
          "jcc:s17:index:skill_value_blocks"
        ],
        "rule": "load route-term lookup doorplates first, then formula bindings/playbooks/full term/entity deep calibration for top 3-8 candidates or when explanation/condition details are required; champion skill numeric truth comes from skill_value_blocks scoring_use when present"
      }
