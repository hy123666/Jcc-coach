{
  "address": "jcc:s17:formula:damage",
  "source": "tft_lab_system_rules",
  "inputs": [
    "damage_type",
    "base_damage",
    "bonus_damage_pct",
    "flat_pen",
    "pct_pen",
    "crit_chance",
    "crit_multiplier",
    "armor",
    "magic_resist",
    "durability_pct",
    "shield",
