{
  "layout_id": "jcc-mumu-16x9-normalized-v1",
  "coordinate_space": "normalized_0_to_1",
  "supported_aspect_ratio": "16:9",
  "layout_mismatch_policy": "emit_layout_mismatch_status",
  "selected_augment_side_rail_policy": {
    "self_owner_scope": "left_rail",
    "opponent_board_scope": "removed_from_product_runtime",
    "view_switch_policy": "Do not infer opponent selected augments, opponent board, or opponent item bench from S=2/current-view screens. Product runtime keeps only self left-rail selected augment slots when explicitly refreshed."
  },
  "on_demand_choice_classifier_policy": {
    "trigger": "user_asks_what_should_i_choose_or_4358_s4_seen",
    "classification_order": [
      "item_choice_panel",
      "augment_choice",
      "unknown_choice_panel"
    ],
    "coarse_scan_policy": "capture_full_frame_then_classify_by_text_card_count_and_icon_density; run OCR/icon matching only on the detected panel ROI",
    "s4_policy": "4358 s=4 is a trigger for immediate visual classification, not proof that the panel is a normal augment choice"
  },
  "dynamic_equipped_item_policy": {
    "primary_source_order": [
      "4356_or_4357_gi_equip_rect_if_non_empty",
      "4353_current_view_unit_position_to_hp_bar_bottom_centered_row",
      "manual_user_confirmation"
    ],
    "roi_model": {
      "model_id": "unit_detected_hp_bar_bottom_row_v3",
      "meaning": "For each 4353 current_view unit, detect the nearby green HP bar, then scan exactly three centered item slots directly below that HP bar. No fixed board-screen offset fallback may promote unit-attached equipment.",
      "slot_semantics": "slot0/slot1/slot2 are the visible equipped-item row under the unit HP bar, not a broad neighborhood search.",
      "promotion_policy": "Only this HP-bar-bottom row is allowed to promote unit-attached equipment candidates. Unit-local grid or board sliding-window scans are debug/calibration-only and must not update live_state."
    },
    "promotion_policy": "unit-attached equipment must be scoped to a current_view unit, gated to stable planning/actionable phase, and derived from the HP-bar-bottom row model"
  },
