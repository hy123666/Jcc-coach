  "schema": "jcc-game-knowledge-common-document-v1",
  "logical_id": "common.glossary",
  "scope": "common",
  "kind": "glossary",
  "season_neutral": true,
  "entity_references": [],
  "entries": [
    { "id": "term.fast_8", "canonical": "快8", "english": "Fast 8", "aliases": ["快8", "快速上8", "Fast 8"], "category": "strategy", "definition": "以经济和经验较快升到8人口，争取更早获得四费和五费核心棋子。" },
    { "id": "term.slow_roll", "canonical": "慢D", "english": "Slow roll", "aliases": ["慢D", "慢搜", "Slow roll"], "category": "strategy", "definition": "停留在适合目标费用的等级并保留经济底线，逐回合搜索目标棋子三星。" },
    { "id": "term.hyper_roll", "canonical": "梭哈", "english": "Hyper roll", "aliases": ["梭哈", "Hyper roll"], "category": "strategy", "definition": "在低人口窗口快速花费大量金币搜索低费三星，风险较高。" },
    { "id": "term.sit_on_gold", "canonical": "攒利息", "english": "Sit on gold", "aliases": ["攒利息", "存钱", "保50", "Sit on gold"], "category": "strategy", "definition": "暂不刷新或升级，优先达到并保持利息档位。" },
    { "id": "term.lose_streak", "canonical": "连败", "english": "Lose streak", "aliases": ["连败", "吃连败", "Lose streak"], "category": "strategy", "definition": "连续输掉PVP回合以获得连败奖励；是否主动控败仍需考虑HP和意外获胜风险。" },
    { "id": "term.win_streak", "canonical": "连胜", "english": "Win streak", "aliases": ["连胜", "Win streak"], "category": "strategy", "definition": "连续赢得PVP回合，通过额外收入、保血和节奏优势滚动扩大领先。" },
    { "id": "term.roll_down", "canonical": "一波D", "english": "Roll down", "aliases": ["一波D", "大D", "Roll down"], "category": "strategy", "definition": "在一个关键回合集中花费大部分可用搜索预算以完成即时质量提升。" },
    { "id": "term.pivot", "canonical": "转型", "english": "Pivot", "aliases": ["转型", "转阵", "Pivot"], "category": "strategy", "definition": "从当前方向切换到另一套更适合当局证据且能够执行的阵容。" },
    { "id": "term.capped_board", "canonical": "拉满", "english": "Capped board", "aliases": ["拉满", "满配", "上限阵容", "Capped board"], "category": "strategy", "definition": "当前资源与人口条件下接近完整上限的阵容状态；不要求所有主C都三星。" },
    { "id": "term.carry", "canonical": "主C", "english": "Carry", "aliases": ["主C", "核心输出", "Carry"], "category": "role", "definition": "阵容的主要输出承担者，通常优先获得关键输出装备，但必须以发布配方和当前局事实确认。" },
    { "id": "term.primary_tank", "canonical": "主坦", "english": "Primary tank", "aliases": ["主坦", "坦克", "肉盾", "Tank"], "category": "role", "definition": "阵容主要承伤者，通常优先获得防御装备。" },
    { "id": "term.bruiser_role", "canonical": "半肉", "english": "Bruiser", "aliases": ["半肉", "战士", "Bruiser"], "category": "role", "definition": "兼具输出和生存能力的中间型战斗角色。" },
    { "id": "term.ad_carry", "canonical": "物理C", "english": "AD carry", "aliases": ["物理C", "AD主C", "AD carry"], "category": "role", "definition": "主要依赖攻击力、普攻或物理技能造成伤害的输出角色。" },
    { "id": "term.ap_carry", "canonical": "法系C", "english": "AP carry", "aliases": ["法系C", "AP主C", "法师", "AP carry"], "category": "role", "definition": "主要依赖法强和技能造成伤害的输出角色。" },
    { "id": "term.frontline", "canonical": "前排", "english": "Frontline", "aliases": ["前排", "Frontline"], "category": "role", "definition": "主要站在靠前区域吸收伤害、控制敌人或保护后排的棋子。" },
    { "id": "term.backline", "canonical": "后排", "english": "Backline", "aliases": ["后排", "Backline"], "category": "role", "definition": "通常站在后方承担输出或辅助职责的棋子。" },
    { "id": "term.reroll_comp", "canonical": "赌狗阵容", "english": "Reroll comp", "aliases": ["赌狗阵容", "三星阵容", "追三阵容", "Reroll comp"], "category": "lineup", "definition": "围绕一费、二费或三费核心棋子追三星的阵容。" },
    { "id": "term.fast_8_comp", "canonical": "快8阵容", "english": "Fast-8 comp", "aliases": ["快8阵容", "四费运营", "Fast-8 comp"], "category": "lineup", "definition": "以八人口搜索四费核心并向高人口上限发展的运营阵容。" },
    { "id": "term.refresh", "canonical": "刷新商店", "english": "Refresh", "aliases": ["D牌", "D", "刷新", "刷新商店", "Refresh"], "category": "action", "definition": "支付标准刷新费用替换当前商店；效果可修改费用或提供免费刷新。" },
    { "id": "term.sit_on_level", "canonical": "卡级", "english": "Sit on level", "aliases": ["卡级", "卡人口", "Sit on level"], "category": "action", "definition": "停留在特定玩家等级，以利用对应费用概率搜索目标棋子。" },
    { "id": "term.level_up", "canonical": "升人口", "english": "Level up", "aliases": ["升人口", "上人口", "升级", "Level up"], "category": "action", "definition": "购买经验或等待自然经验提高玩家等级与可上场人数。" },
    { "id": "term.buy_xp", "canonical": "买经验", "english": "Buy XP", "aliases": ["F", "买经验", "拉人口", "Buy XP"], "category": "action", "definition": "支付金币购买经验；多次购买可在同一回合完成升级。" },
    { "id": "term.lock_shop", "canonical": "锁商店", "english": "Lock shop", "aliases": ["锁住", "锁商店", "Lock shop"], "category": "action", "definition": "保留当前商店内容，使其不会在下一次常规刷新时自动替换。" },
    { "id": "term.sell_unit", "canonical": "卖棋子", "english": "Sell unit", "aliases": ["卖牌", "卖棋子", "卖弈子", "Sell unit"], "category": "action", "definition": "出售已拥有棋子以获得返还金币并释放棋盘或备战席空间。" },
    { "id": "term.emblem", "canonical": "纹章", "english": "Emblem", "aliases": ["纹章", "转职", "Emblem"], "category": "system", "definition": "为持有者提供额外羁绊身份的特殊装备；是否可合成必须以当前版本正式配方为准。" },
    { "id": "term.artifact", "canonical": "神器", "english": "Artifact", "aliases": ["神器", "Artifact"], "category": "system", "definition": "通常不能通过普通散件配方合成的特殊装备。" },
    { "id": "term.prismatic", "canonical": "棱彩", "english": "Prismatic", "aliases": ["棱彩", "彩色", "Prismatic"], "category": "system", "definition": "强化品质中的最高常规梯度。" },
    { "id": "term.augment", "canonical": "强化", "english": "Augment", "aliases": ["强化", "强化符文", "海克斯", "Hex", "Augment"], "category": "system", "definition": "标准局在2-1、3-2和4-2各选择一次的局内增益，通常分白银、黄金和棱彩。" },
    { "id": "term.carousel", "canonical": "选秀", "english": "Carousel", "aliases": ["选秀", "转盘", "Carousel"], "category": "system", "definition": "标准局在2-4、3-4、4-4、5-4、6-4和7-4出现的共享选取环节。" },
    { "id": "term.grid", "canonical": "格子", "english": "Board hex", "aliases": ["格子", "棋盘格", "六边形格子", "Board hex"], "category": "system", "definition": "棋盘上用于部署和站位的六边形位置；中文玩家通常简称为格子。" },
    { "id": "term.best_in_slot", "canonical": "神装", "english": "Best in slot", "aliases": ["神装", "最优装备", "BIS", "Best in slot"], "category": "abbreviation", "definition": "针对具体角色、阵容和环境的优先装备组合，不代表脱离条件的绝对唯一答案。" },
    { "id": "term.aoe", "canonical": "范围伤害", "english": "AOE", "aliases": ["AOE", "范围伤害"], "category": "abbreviation", "definition": "能够影响多个目标或一片区域的伤害。" },
    { "id": "term.crowd_control", "canonical": "控制", "english": "Crowd control", "aliases": ["控", "控制", "CC"], "category": "abbreviation", "definition": "眩晕、沉默、嘲讽、定身等限制行动或目标选择的效果。" },
    { "id": "term.dps", "canonical": "每秒伤害", "english": "DPS", "aliases": ["DPS", "每秒输出", "每秒伤害"], "category": "abbreviation", "definition": "单位时间内的平均伤害输出。" },
    { "id": "term.hp", "canonical": "生命值", "english": "HP", "aliases": ["HP", "血量", "生命值"], "category": "abbreviation", "definition": "玩家或棋子的生存资源；语境决定指玩家HP还是棋子生命值。" },
    { "id": "term.ad", "canonical": "攻击力", "english": "AD", "aliases": ["AD", "攻击", "攻击力"], "category": "abbreviation", "definition": "影响普攻和部分物理技能的攻击属性。" },
    { "id": "term.ap", "canonical": "法术强度", "english": "AP", "aliases": ["AP", "法强", "法术强度"], "category": "abbreviation", "definition": "影响技能数值的法术强度属性。" },
    { "id": "term.attack_speed", "canonical": "攻击速度", "english": "Attack speed", "aliases": ["攻速", "攻击速度", "AS"], "category": "abbreviation", "definition": "单位时间内进行普通攻击的频率。" },
    { "id": "term.average_placement", "canonical": "平均排名", "english": "Average placement", "aliases": ["平均排名", "平均名次", "Average placement"], "category": "metric", "definition": "阵容对局名次的平均值，数字越低通常表示整体表现越好。" }
  ]
}
