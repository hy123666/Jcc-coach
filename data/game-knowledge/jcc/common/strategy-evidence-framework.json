    },
    {
      "id": "economy_tempo",
      "intent_terms": ["经济", "金币", "利息", "连胜", "连败", "升级", "升人口", "D牌", "搜牌", "保血", "卖血", "节奏"],
      "critical_facets": ["common_game_doctrine", "current_match_state", "deterministic_math"],
      "optional_facets": ["target_or_candidate_direction", "active_effect_timing"]
    },
    {
      "id": "current_match_strategy",
      "intent_terms": ["这把", "现在", "当前", "接下来", "该怎么办", "巡航", "适合玩什么", "转不转"],
      "critical_facets": ["common_game_doctrine", "current_core_identity", "current_match_state"],
      "optional_facets": ["target_or_candidate_direction", "formation_difficulty_profile", "semantic_seed", "candidate_frontier", "semantic_relations", "ranking_observations", "deterministic_math"]
    },
    {
      "id": "lobby_meta_strategy",
      "intent_terms": ["上分思路", "当前版本", "版本环境", "当前环境", "强势阵容", "版本上分"],
      "critical_facets": ["common_game_doctrine", "current_core_identity", "ranking_observations"],
      "optional_facets": ["ranking_lineup_candidates", "formation_difficulty_profile", "ranking_item_observations", "ranking_augment_associations", "semantic_relations"]
    },
    {
      "id": "postgame_review_strategy",
      "intent_terms": ["复盘", "上一把", "上一局", "为什么输了", "为什么第四", "复盘聊天"],
      "critical_facets": ["common_game_doctrine", "current_core_identity", "recent_match_decision_summaries"],
      "optional_facets": ["ranking_observations", "formation_difficulty_profile", "semantic_relations"]
    },
    {
      "id": "ranking_query",
      "intent_terms": ["大数据", "国服", "大师以上", "榜单", "胜率", "前四率", "登顶率", "平均排名", "热门阵容"],
