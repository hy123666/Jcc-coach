{
  "schema": "jcc-game-knowledge-common-document-v1",
  "logical_id": "common.strategy_evidence_framework",
  "scope": "common",
  "kind": "strategy_evidence_framework",
  "season_neutral": true,
  "entity_references": [],
  "purpose": "Define the shared evidence language used by direct questions, structured choices, and proactive Cruise without turning strategy judgement into one global program or score.",
  "entries": [
    {
      "id": "strategy_evidence.framework",
      "framework_schema": "jcc-common-strategy-evidence-framework-v1",
      "routes": [
    {
      "id": "rules_explanation",
      "intent_terms": ["怎么玩", "规则", "怎么赢", "利息", "经验", "升级", "扣血", "牌库", "刷新概率"],
      "critical_facets": ["common_game_doctrine", "current_core_identity"],
      "optional_facets": ["deterministic_math", "current_match_state"]
    },
    {
      "id": "entity_details",
      "intent_terms": ["英雄", "棋子", "技能", "属性", "羁绊", "装备", "强化", "海克斯", "几费", "定位"],
      "critical_facets": ["current_core_identity", "current_core_entity_details"],
      "optional_facets": ["current_match_state", "ranking_observations"]
    },
    {
      "id": "lineup_construction",
      "intent_terms": ["阵容", "搭一套", "九五", "95", "84", "成型", "主C", "主坦", "替换"],
      "critical_facets": ["common_game_doctrine", "current_core_identity", "champion_trait_map", "champion_skill_role_profiles", "legal_roster_solution"],
      "optional_facets": ["current_match_state", "ranking_lineup_candidates", "formation_difficulty_profile", "semantic_seed", "candidate_frontier", "semantic_relations"]
    },
    {
      "id": "transition_planning",
      "intent_terms": ["过渡", "六人口", "6人口", "七人口", "7人口", "八人口", "8人口", "平替", "替换成本", "装备通用"],
      "critical_facets": ["current_core_identity", "transition_candidates", "equipment_continuity"],
      "optional_facets": ["current_match_state", "ranking_transition_evidence", "formation_difficulty_profile", "semantic_seed", "candidate_frontier", "semantic_relations"]
    },
    {
      "id": "itemization",
      "intent_terms": ["装备", "出装", "神装", "合装", "散件", "神器", "光明", "装备通用", "施法频率", "伤害最大"],
      "critical_facets": ["current_core_identity", "equipment_effects_and_fit"],
      "optional_facets": ["current_equipment_and_holders", "deterministic_math", "semantic_seed", "candidate_frontier", "ranking_item_observations"]
    },
    {
