      "optional_facets": ["ranking_lineup_candidates", "ranking_item_observations", "ranking_augment_associations"]
    }
  ],
      "coverage_states": ["satisfied", "missing", "forbidden", "not_applicable", "degraded"],
      "evidence_classes": {
    "common": "Season-neutral rules, doctrine, formulas, routes, tags, and relation meanings.",
    "core": "Match-pinned current-season entities, effects, legality, formulas, aliases, and semantic features.",
    "ranking": "Compatible current-day Tencent/JCC Master+ observations and atomic recipes only.",
    "match": "Current SQLite-owned live facts, explicit confirmations, choices, target state, and freshness.",
    "deterministic": "DecisionMath and route-specific evaluator results with assumptions and claim boundaries."
  },
      "policy": {
    "multi_route_planning_required": true,
    "tags_organize_and_expand_evidence_but_do_not_own_strength": true,
    "typed_identity_legality_and_source_policy_remain_authoritative": true,
    "agent_owns_tradeoffs_strategy_and_explanation": true,
    "runtime_owns_source_selection_snapshot_budget_and_coverage": true,
    "critical_missing_evidence_must_be_disclosed_or_block_the_affected_claim": true
  },
      "extension_policy": {
    "new_route": "Add only when an existing route cannot express a materially different evidence obligation.",
    "new_facet_or_tag": "Add to Common only when it is season-neutral and cannot be represented by the existing vocabulary; version-owned meanings remain in Core compilation.",
    "major_season_update": "Compile the new season's entities into these routes and audit unmapped semantics without copying or renaming the Common framework."
      }
    },
    {
      "id": "formation_difficulty",
      "framework_schema": "jcc-common-formation-difficulty-framework-v1",
      "purpose": "Describe how difficult a lineup is to make and how ready the current match is to realize it, without changing national strength authority.",
      "ownership": {
        "common": "season-neutral dimensions, evidence states, and lifecycle vocabulary",
        "core": "current-version costs, legality, traits, effects, craftability, and special mechanics",
        "ranking": "current-day roster, recipe, transition, hero-heat, and explicit requirement evidence",
        "runtime": "transient current-match readiness from stage, HP, economy, board, copies, equipment, and choices"
      },
      "parallel_outputs": [
        "national_strength",
        "formation_burden",
        "current_formation_readiness"
      ],
      "dimensions": [
        "target_population",
        "high_cost_dependency",
        "star_requirements",
        "emblem_or_transfer_dependency",
        "augment_dependency",
        "item_dependency",
        "special_mechanic_dependency",
        "trait_breakpoint_pressure",
        "transition_support",
        "equipment_continuity",
        "preformation_loss_risk",
        "contest_pressure",
        "flexibility_and_replacement_cost"
      ],
      "evidence_states": ["explicit", "derived", "unknown", "not_applicable"],
      "rules": {
        "strength_is_not_reduced_by_burden": true,
        "hero_or_lineup_use_rate_is_heat_not_formation_probability": true,
        "recommended_augments_are_not_required_without_explicit_evidence": true,
        "high_three_star_rank_is_not_a_mandatory_star_requirement": true,
        "unknown_requirements_remain_unknown": true,
        "runtime_readiness_is_not_persisted_as_ranking_fact": true
      },
      "archetype_inputs": [
        "one_cost_reroll",
        "two_cost_reroll",
        "three_cost_reroll",
        "four_cost_reroll_or_theft_ancestor",
        "eight_population_four_cost_operation",
        "nine_population_five_cost_operation",
        "special_mechanic_lineup"
      ]
    }
  ]
}
