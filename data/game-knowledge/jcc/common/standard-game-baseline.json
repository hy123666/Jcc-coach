      "specific_unit_probability": "cost_odds_at_level * remaining_target_copies / remaining_pool_copies_for_cost",
      "effect_override_policy": "An active season must explicitly declare any changed shop odds, bag sizes, reroll cost, or shop size."
    },
    {
      "id": "standard.combat_damage",
      "damage_types": ["physical", "magic", "true"],
      "raw_damage": "base_damage * (1 + damage_amp_pct)",
      "critical_raw_damage": "raw_damage * critical_damage_multiplier",
      "effective_resist": "max(0, relevant_resist * (1 - percent_penetration) - flat_penetration)",
      "resist_multiplier": "physical_or_magic ? 100 / (100 + effective_resist) : 1",
      "durability_multiplier": "1 - durability_pct",
      "non_critical_damage": "raw_damage * resist_multiplier * durability_multiplier",
      "critical_damage": "critical_raw_damage * resist_multiplier * durability_multiplier",
      "expected_damage": "non_critical_damage * (1 - critical_chance) + critical_damage * critical_chance",
      "hits_to_kill": "ceil((health + shield) / expected_damage)",
      "true_damage_policy": "True damage ignores armor and magic resistance but still applies explicitly supplied durability unless an effect states otherwise.",
      "simulation_boundary": "This is a deterministic single-hit expectation. Targeting, attack timing, mana gain from damage, crowd control, healing, shields gained later, overkill, and conditional effects require additional inputs."
