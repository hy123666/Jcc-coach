      "xp_to_next_level": { "2": 2, "3": 6, "4": 10, "5": 20, "6": 36, "7": 56, "8": 68, "9": 68 },
      "cumulative_xp_to_level": { "2": 0, "3": 2, "4": 8, "5": 18, "6": 38, "7": 74, "8": 130, "9": 198, "10": 266 },
      "reference_purchase_gold_at_standard_natural_timing": { "3": 0, "4": 4, "5": 8, "6": 20, "7": 36, "8": 56, "9": 68, "10": 68 },
      "exact_purchase_formula": "ceil(max(target_cumulative_xp - current_cumulative_xp, 0) / xp_per_purchase) * gold_per_purchase",
      "effect_override_policy": "Explicit effects may change natural XP, XP purchase size, XP price, or maximum level."
    },
    {
