{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jcc-game-knowledge-common-document-v1",
  "type": "object",
  "required": ["schema", "logical_id", "scope", "kind", "season_neutral", "entity_references", "entries"],
  "properties": {
    "schema": { "const": "jcc-game-knowledge-common-document-v1" },
    "logical_id": { "type": "string", "pattern": "^common\\.[a-z][a-z0-9_]*$" },
    "scope": { "const": "common" },
    "kind": { "type": "string", "minLength": 1 },
    "season_neutral": { "const": true },
    "entity_references": { "type": "array", "maxItems": 0 },
    "entries": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id"] } }
  },
  "additionalProperties": false
}
