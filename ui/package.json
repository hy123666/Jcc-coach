{
  "name": "jcc-runtime-ui",
  "version": "0.1.6",
  "private": true,
  "description": "JCC Runtime coach for Teamfight Tactics",
  "author": "JCC Runtime contributors",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "electron": "cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "electron:built": "electron .",
    "start": "concurrently -k \"npm:dev\" \"wait-on http://127.0.0.1:5173 && npm run electron\"",
    "start:built": "npm run electron:built",
    "build": "tsc --noEmit && vite build",
    "package:win": "node ../tools/verify-jcc-windows-installer-resources.mjs && npm run build && electron-builder --config electron-builder.yml",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "lucide-react": "^0.561.0",
    "minisearch": "^7.2.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "vite": "^7.2.7"
  },
  "devDependencies": {
    "electron": "^39.2.7",
    "electron-builder": "26.0.12",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "typescript": "^5.9.3",
    "wait-on": "^9.0.3"
  }
}
