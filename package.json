{
  "name": "jcc-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "knowledge:pipeline": "node tools/run-jcc-version-pipeline.mjs",
    "knowledge:verify": "node tools/run-jcc-version-pipeline.mjs verify",
    "runtime:bootstrap": "node tools/bootstrap-jcc-runtime-agent.mjs",
    "runtime:product-gate": "node tools/verify-jcc-runtime-product-gate.mjs",
    "runtime:gate:deterministic": "node tools/verify-jcc-runtime-product-gate.mjs --profile deterministic",
    "runtime:gate:provider-contract": "node tools/verify-jcc-runtime-product-gate.mjs --profile provider_contract",
    "runtime:gate:live-acceptance": "node tools/verify-jcc-runtime-product-gate.mjs --profile live_acceptance",
    "runtime:gate:verify": "node tools/verify-jcc-product-gate-classification.mjs",
    "runtime:goal-audit": "node tools/verify-jcc-goal-acceptance-audit.mjs",
    "runtime:benchmark:modes": "node tools/verify-jcc-runtime-mode-host-request-benchmark.mjs",
    "runtime:readiness": "node tools/verify-jcc-product-readiness.mjs",
    "runtime:live:mumu": "node tools/verify-jcc-live-acceptance-soak.mjs --require-live-mumu",
    "runtime:live:replay-ocr": "node tools/verify-jcc-live-replay-ocr-journey.mjs",
    "runtime:live:replay-ocr:e2e": "node tools/verify-jcc-live-replay-ocr-journey.mjs --real-host",
    "runtime:live:codex": "node tools/verify-jcc-codex-cli-live-selected-context.mjs --require-live",
    "runtime:live:codex:production": "node tools/verify-jcc-codex-cli-production-scenarios.mjs --require-live",
    "runtime:live:kimi": "node tools/verify-jcc-kimi-cli-live-availability.mjs --require-live",
    "runtime:verify:journey-matrix": "node tools/verify-jcc-full-player-journey-matrix.mjs",
    "runtime:login:kimi": "node tools/login-jcc-kimi-cli.mjs",
    "runtime:verify:kimi-discovery": "node tools/verify-jcc-kimi-discovery-policy.mjs",
    "repo:hygiene": "node tools/audit-jcc-repo-hygiene.mjs",
    "repo:cleanup:dry": "node tools/cleanup-jcc-generated-artifacts.mjs",
    "repo:cleanup": "node tools/cleanup-jcc-generated-artifacts.mjs --apply",
    "ui:dev": "npm --prefix ui run dev",
    "ui:electron": "npm --prefix ui run electron",
    "ui:start": "npm --prefix ui run start",
    "ui:launch": "node tools/launch-jcc-runtime-electron.mjs",
    "ui:shortcut:install": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tools/install-jcc-runtime-desktop-shortcut.ps1",
    "ui:shortcut:remove": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tools/install-jcc-runtime-desktop-shortcut.ps1 -Action Remove",
    "ui:restart": "node tools/restart-jcc-runtime-electron.mjs",
    "ui:build": "npm --prefix ui run build",
    "ui:preview": "npm --prefix ui run preview"
  }
}
